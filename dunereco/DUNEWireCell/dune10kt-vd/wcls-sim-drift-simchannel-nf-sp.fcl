#include "services_dune.fcl"

process_name: wclssim
physics :{
   producers: {
      plopper : {
        module_type : BlipMaker
      }
      tpcrawdecoder : {
         module_type : WireCellToolkit
         wcls_main: {
            tool_type: WCLS
            apps: ["TbbFlow"] # Pgrapher, TbbFlow

            # logsinks: ["stdout:info", "wcls-sim-drift-simchannel-nf-sp.log:debug"]
            logsinks: ["stdout:debug"]
            loglevels: ["debug"]

            plugins: ["WireCellPgraph", "WireCellGen","WireCellSio","WireCellRoot","WireCellLarsoft"
            ,"WireCellTbb"
            # , "WireCellPytorch"
            ]

            // needs to be found via your WIRECELL_PATH
            configs: ["pgrapher/experiment/dune10kt-vd/wcls-sim-drift-simchannel-nf-sp.jsonnet"]


            // Contract note: these exact "type:name" must be used to identify
            // the configuration data structures for these components in the Jsonnet.

            // The graph's depo source is a wclsSimDepoSetSource (the "deposet"
            // node), so the inputer type must match that (was previously the
            // mismatched "wclsSimDepoSource:").
            inputers: ["wclsSimDepoSetSource:"]

            // Each art output converter (FrameSaver / SimChannelSink) must be
            // listed here by "type:name" matching its WCT node name.
            //
            // For the single-* / full modes the savers are named "simdigits" and
            // "spsignals" (below).  For process_mode "multi-sim" there is NO
            // "simdigits"/"spsignals"; instead each TPC id <k> in
            // structs.process_tpc_indices yields a pair named "simdigits<k>"
            // (raw::RawDigit) and "spsignals<k>" (recob::Wire).  So for
            // multi-sim you MUST replace the two lines below with one pair per
            // TPC, e.g. for process_tpc_indices = [0,1,2,3]:
            //   "wclsFrameSaver:simdigits0", "wclsFrameSaver:spsignals0",
            //   "wclsFrameSaver:simdigits1", "wclsFrameSaver:spsignals1",
            //   "wclsFrameSaver:simdigits2", "wclsFrameSaver:spsignals2",
            //   "wclsFrameSaver:simdigits3", "wclsFrameSaver:spsignals3",
            outputers: [
                "wclsSimChannelSink:postdrift",
                "wclsFrameSaver:spsignals"
                , "wclsFrameSaver:simdigits"
            ]

            // Make available parameters via Jsonnet's std.extVar()
            params: {
                # file: wires
                # dunevd10kt_3view_30deg_v6_refactored.json.bz2
                # files_wires: "dunevd10kt_3view_30deg_v5_refactored_1x8x6ref.json.bz2"
                files_wires: "dunevd10kt_3view_30deg_v6_refactored.json.bz2"
                # file: fields, used for both bottom and top drift volumes
                # protodunevd_FR_imbalance3p_260501.json.bz2 same CRP strips as PD-VD, response_plane 18.1 cm
                # dunevd-resp-isoc3views-18d92.json.bz2 30,-30,90 (old, 5mm pitch), response_plane 18.92 cm
                # pcbro-response-avg-12d50.json.bz2 2view prototype
                files_fields: "protodunevd_FR_imbalance3p_260501.json.bz2"
                # noise spectra are set in params-10kt.jsonnet as in protodunevd,
                # bottom drift is selected by elecGain (7.8 or 14 mV/fC)
                # set mapping between internal wct plane ids and larsoft
                # default is to assume WireCell::kU->geo::kU, kV->kV, kW->kW
                # 3view-30deg: default, 3view: dunevd_3view
                geo_planeid_labels: "default"
                # art InputTag of the input SimEnergyDeposit depos the WCLS source
                # reads (full "label:instance" honored). e.g. the BlipMaker test
                # source puts to instance "bogus" -> use "IonAndScint:bogus".
                input_depos_tag: "IonAndScint"
                # Processing mode.  Governs which TPCs are processed and how
                # their output products are organized:
                #   single-sim / single-sp / single-sim-sp
                #       process ONE TPC (structs.process_tpc_index); outputs are
                #       tpc-suffixed (daqtpc<i>, gausstpc<i>, ...).
                #   full
                #       process ALL TPCs, merged into one product per tier.
                #   multi-sim
                #       process the LIST of TPCs in structs.process_tpc_indices;
                #       the depo set is fanned out and EACH TPC terminates in its
                #       OWN FrameSaver(s) -> one RawDigit product (instance =
                #       params.frame_tag_pattern % tpc_id) AND one recob::Wire
                #       product (instances gauss<id>/wiener<id>[/dnnsp<id>]) PER
                #       TPC.  (See wcls-sim-drift-simchannel-nf-sp-multi.jsonnet.)
                process_mode: "single-sp"
                # multi-sim only: C-style format (one %d) interpolated on the TPC
                # id to name the per-TPC raw::RawDigit product instance.
                frame_tag_pattern: "daq%d"
                # graph-execution engine: "TbbFlow" (multi-threaded) or
                # "Pgrapher" (single-threaded serial).  Must match wcls_main.apps.
                engine: "TbbFlow"
            }
            structs: {
                # number of time samples
                # bottom drift (cold electronics) front-end gain [mV/fC]
                elecGain: 14
                nticks: @local::dunefdvd_detproperties.NumberTimeSamples
                # Longitudinal diffusion constant [cm2/ns] 4.0e-9
                DL: @local::dunefd_largeantparameters.LongitudinalDiffusion
                # Transverse diffusion constant [cm2/ns] 8.8e-9
                DT: @local::dunefd_largeantparameters.TransverseDiffusion
                # Electron lifetime [us] #10.4e3
                lifetime: 10.4e3 #@local::dunefdvd_detproperties.Electronlifetime
                # Electron drift speed is calculated from E-field [kV/cm] and temperature [K]
                efield: @local::dunefdvd_detproperties.Efield[0]
                temperature: @local::dunefdvd_detproperties.Temperature
                # G4RefTime [us]
                G4RefTime: @local::dunefd_detectorclocks.G4RefTime
                # response plane [cm]
                response_plane: 18.1 # must match files_fields
                # when process_mode is single-*, this specifies which APA to process (0-319)
                process_tpc_index: 0
                # when process_mode is "multi-sim", this gives the LIST of TPC
                # ids to process, each producing its own per-TPC products.  NOTE:
                # this is a struct (injected as Jsonnet code via std.extVar), so
                # it is given as a quoted string holding a Jsonnet array literal.
                process_tpc_indices: "[0, 1, 2, 3]"
                use_hydra: true
                save_rawdigits: false
                # use dnn_roi or not
                use_dnnroi: false
                adc_resolution: 14
                # TbbFlow max thread count (tbb::global_control); 0 = all cores.
                # Ignored by the Pgrapher engine.
                max_threads: 0
            }

         }
      }
   }
   p1 : [ plopper, tpcrawdecoder ]
   outputFiles : [ out ]
   
   trigger_paths : [ p1 ]
   end_paths: [ outputFiles ]
}
outputs: {
   out: {
      module_type: RootOutput
      // fileName: "%ifb_wcsim.root"
      fileName: "wcsim.root"

      outputCommands :   [
         # "keep *_*_*_*", "drop *", "keep recob::Wires_*_*_*"
         "keep *_*_*_*"
      ]

   }
}
