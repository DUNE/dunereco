#include "services_dune.fcl"

process_name: wclssim
physics :{
   producers: {
      plopper : {
        module_type : BlipMaker
      }
      tpcrawdecoder : {
         module_type : WireCellToolkit
         wcls_main: {
            tool_type: WCLS
            apps: ["TbbFlow"] # Pgrapher, TbbFlow

            # logsinks: ["stdout:info", "wcls-sim-drift-simchannel-nf-sp.log:debug"]
            logsinks: ["stdout:debug"]
            loglevels: ["debug"]

            plugins: ["WireCellPgraph", "WireCellGen","WireCellSio","WireCellRoot","WireCellLarsoft"
            ,"WireCellTbb"
            # , "WireCellPytorch"
            ]

            // needs to be found via your WIRECELL_PATH
            configs: ["pgrapher/experiment/dune10kt-vd/wcls-sim-drift-simchannel-nf-sp.jsonnet"]


            // Contract note: these exact "type:name" must be used to identify
            // the configuration data structures for these components in the Jsonnet.

            inputers: ["wclsSimDepoSource:"]
            outputers: [
                "wclsSimChannelSink:postdrift",
                "wclsFrameSaver:spsignals"
                , "wclsFrameSaver:simdigits"
            ]

            // Make available parameters via Jsonnet's std.extVar()
            params: {
                # file: wires
                # dunevd10kt_3view_30deg_v6_refactored.json.bz2
                # files_wires: "dunevd10kt_3view_30deg_v5_refactored_1x8x6ref.json.bz2"
                files_wires: "dunevd10kt_3view_30deg_v6_refactored.json.bz2"
                # file: fields, used for both bottom and top drift volumes
                # protodunevd_FR_imbalance3p_260501.json.bz2 same CRP strips as PD-VD, response_plane 18.1 cm
                # dunevd-resp-isoc3views-18d92.json.bz2 30,-30,90 (old, 5mm pitch), response_plane 18.92 cm
                # pcbro-response-avg-12d50.json.bz2 2view prototype
                files_fields: "protodunevd_FR_imbalance3p_260501.json.bz2"
                # noise spectra are set in params-10kt.jsonnet as in protodunevd,
                # bottom drift is selected by elecGain (7.8 or 14 mV/fC)
                # set mapping between internal wct plane ids and larsoft
                # default is to assume WireCell::kU->geo::kU, kV->kV, kW->kW
                # 3view-30deg: default, 3view: dunevd_3view
                geo_planeid_labels: "default"
                # single-sp, single-sim, single-sim-sp, full
                process_mode: "single-sp"
            }
            structs: {
                # number of time samples
                # bottom drift (cold electronics) front-end gain [mV/fC]
                elecGain: 14
                nticks: @local::dunefdvd_detproperties.NumberTimeSamples
                # Longitudinal diffusion constant [cm2/ns] 4.0e-9
                DL: @local::dunefd_largeantparameters.LongitudinalDiffusion
                # Transverse diffusion constant [cm2/ns] 8.8e-9
                DT: @local::dunefd_largeantparameters.TransverseDiffusion
                # Electron lifetime [us] #10.4e3
                lifetime: 10.4e3 #@local::dunefdvd_detproperties.Electronlifetime
                # Electron drift speed is calculated from E-field [kV/cm] and temperature [K]
                efield: @local::dunefdvd_detproperties.Efield[0]
                temperature: @local::dunefdvd_detproperties.Temperature
                # G4RefTime [us]
                G4RefTime: @local::dunefd_detectorclocks.G4RefTime
                # response plane [cm]
                response_plane: 18.1 # must match files_fields
                # when process_mode is single-*, this specifies which APA to process (0-319)
                process_tpc_index: 0
                use_hydra: true
                save_rawdigits: false
                # use dnn_roi or not
                use_dnnroi: false
                adc_resolution: 14
            }

         }
      }
   }
   p1 : [ plopper, tpcrawdecoder ]
   outputFiles : [ out ]
   
   trigger_paths : [ p1 ]
   end_paths: [ outputFiles ]
}
outputs: {
   out: {
      module_type: RootOutput
      // fileName: "%ifb_wcsim.root"
      fileName: "wcsim.root"

      outputCommands :   [
         # "keep *_*_*_*", "drop *", "keep recob::Wires_*_*_*"
         "keep *_*_*_*"
      ]

   }
}
