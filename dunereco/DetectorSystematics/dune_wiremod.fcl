#BEGIN_PROLOG

duneWiremod: {

  module_type: "WireModifier"

             
  
  WireLabel:           "tpcrawdecoder:gauss"
  HitLabel:            "gaushit"
  EDepOrigLabel:       "IonAndScint"
  EDepShftLabel:       "IonAndScint"
  SimChannelLabel:     "tpcrawdecoder:simpleSC"
  G4Label:             "largeant"

  useSimChannels: true #set to true to use simChannels and IDEs instead of edeps

  # Use this for applying an offset or not.  Default is to not use an offset (the BNB).  Using an offset is for the NuMI systematics.
  ApplyAdditionalTickOffset: false

  ApplyLowECut: false

  ApplyGainScale: false 
  ElectronicsGainScale: 2.00

  ApplyLifetimeVar: false
  LifetimeVar: 6000 # in microseconds

  ApplyModBoxVar: false
  ModBoxAlphaVar: 0.87
  ModBoxBetaVar: 0.218

  ApplyLongitudinalDiffusionVar: false
  DLvar: 12e-9

  ApplyTransverseDiffusionVar: false
  DTvar: 1.0e-8 #in cm^2/ns

  SaveChargeRatioPlot: false
  SaveEdepMatchingPlots: false

  AdditiveModification: false #defines how the ROI is modified, additive appraoch prevents explosion of tails

  nNeighbourWires: 0 #Number of neighbour wires to consider for matching an edep to an ROI 
  nTickTolerance: 0 #tolerance for a projected tick to be associated to a signal ROI
}

#END_PROLOG
