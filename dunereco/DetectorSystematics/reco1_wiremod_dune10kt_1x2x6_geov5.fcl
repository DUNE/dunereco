#include "standard_reco1_dune10kt_1x2x6.fcl"
#include "wiremod.fcl"

# change process name, to be able to rerun it
process_name: reco1Again

source: {
   module_type: RootInput
   maxEvents: -1
}

physics.producers.duneWiremod: @local::duneWiremod
physics.producers.duneWiremod.useSimChannels: true

physics.producers.duneWiremod.ApplyLifetimeVar: true
physics.producers.duneWiremod.LifetimeVar: 6000

physics.producers.duneWiremod.ApplyModBoxVar: false
physics.producers.duneWiremod.ModBoxAlphaVar: 0.99
physics.producers.duneWiremod.ModBoxBetaVar: 0.218 

physics.producers.duneWiremod.SaveChargeRatioPlot: false
physics.producers.duneWiremod.SaveEdepMatchingPlots: false

physics.producers.duneWiremod.AdditiveModification: false #defines how the ROI is modified, additive appraoch prevents explosion of tails

physics.producers.duneWiremod.nNeighbourWires: 0 #Number of neighbour wires to consider for matching an edep to an ROI 
physics.producers.duneWiremod.nTickTolerance: 0 #tolerance for a projected tick to be associated to a signal ROI

physics.producers.gaushitWireMod: @local::physics.producers.gaushit
physics.producers.gaushitWireMod.CalDataModuleLabel: "duneWiremod"

physics.producers.spsolve.HitLabel: "gaushitWireMod"
physics.producers.hitfd.HitModuleLabel: "gaushitWireMod"

physics.reco: [
  gaushit,
  duneWiremod,
  gaushitWireMod #,
#  spsolve,
#  hitfd,
#  rns
]

physics.trigger_paths: [ reco ]

services:
{
  @table::services
  @table::dunefd_1x2x6_simulation_services
  Geometry: @local::dune10kt_1x2x6_v5_refactored_geo
  AuxDetGeometry: @local::dune10kt_1x2x6_v5_refactored_auxdet_geo
}
