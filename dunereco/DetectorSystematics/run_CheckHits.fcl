#include "services_dune.fcl"
#include "CheckHitsConfig.fcl"

process_name: checks

source:
{
  module_type: RootInput
               maxEvents: -1
}

services:
{
  @table::dunefd_1x2x6_simulation_services
  Geometry: @local::dune10kt_1x2x6_v5_refactored_geo
  AuxDetGeometry: @local::dune10kt_1x2x6_v5_refactored_auxdet_geo
  TimeTracker:           {}
  MemoryTracker:         {} # default is one
  TFileService: { fileName: "%ifb_vdhitsscwiresdump.root" }
}

physics:
{
  analyzers:
  {
    checkhits: @local::CheckFDHits
  }
  path0:     [ checkhits ]
  end_paths: [ path0 ]
}

